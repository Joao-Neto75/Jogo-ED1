<?xml version="1.0" encoding="UTF-8"?>
<!-- Módulo desktop (Windows e Linux): lançador LWJGL3 e JAR executável único com os assets. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.ed1.candymatch</groupId>
        <artifactId>candymatch</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>lwjgl3</artifactId>
    <packaging>jar</packaging>

    <properties>
        <classe.principal>br.ed1.candymatch.lwjgl3.Lwjgl3Launcher</classe.principal>
    </properties>

    <dependencies>
        <dependency>
            <groupId>br.ed1.candymatch</groupId>
            <artifactId>core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-backend-lwjgl3</artifactId>
            <version>${gdx.version}</version>
        </dependency>
        <!-- Bibliotecas nativas de Windows e Linux (o artefato oficial também inclui as de macOS). -->
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-platform</artifactId>
            <version>${gdx.version}</version>
            <classifier>natives-desktop</classifier>
        </dependency>
        <dependency>
            <groupId>com.badlogicgames.gdx</groupId>
            <artifactId>gdx-freetype-platform</artifactId>
            <version>${gdx.version}</version>
            <classifier>natives-desktop</classifier>
        </dependency>
    </dependencies>

    <build>
        <!--
          Os assets entram no jar: quando um arquivo não existe na pasta atual, Gdx.files.internal procura
          no classpath. Assim o CandyMatch.jar roda de qualquer pasta. Ranking e salvamento (Gdx.files.local)
          são gravados na pasta de onde o jogo foi aberto.
        -->
        <resources>
            <resource>
                <directory>${project.basedir}/../assets</directory>
                <excludes>
                    <exclude>ranking.txt</exclude>
                    <exclude>salvamento.txt</exclude>
                    <exclude>**/.gitkeep</exclude>
                </excludes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>CandyMatch</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${classe.principal}</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>META-INF/versions/**/module-info.class</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ./mvnw -pl lwjgl3 -am compile exec:exec : abre o jogo usando a pasta assets como diretório de trabalho. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                    <executable>java</executable>
                    <workingDirectory>${project.basedir}/../assets</workingDirectory>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${classe.principal}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
